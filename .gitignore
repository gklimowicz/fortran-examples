# Compiled Object files
**/*.slo
**/*.lo
**/*.o
**/*.obj

# Precompiled Headers
**/*.gch
**/*.pch

# Compiled Dynamic libraries
**/*.so
**/*.dylib
**/*.dll

# Fortran module files
**/*.mod
**/*.smod

# Compiled Static libraries
**/*.lai
**/*.la
**/*.a
**/*.lib

# Executables
**/*.exe
**/*.out
**/*.app

# Miscellany
**/.DS_Store
.markdown-preview.html
src/*.log

# Note that we shouldn't commit build files at all.
# But this repo takes so long to populate the project
# trees and update, it's probably more convenient
# for the rest-of-world if we just save the built
# files in the repo.

# Build file logs
build/update-failures.txt
build/update-log.txt

# Build files that we commit to git as compressed
build/all-files.txt
build/all-fortran-files-attr.txt
