#!/usr/bin/env bash

trap "exit 1" HUP INT QUIT TERM

set -e -u -o pipefail

CMD="$(basename $0)"
CMD_DIR="$(dirname $0)"
function usage {
    (echo "Usage: $CMD [-hnv] file..."
     echo "-f        Pass -f to git commands."
     echo "-h        Print this help message."
     echo "-n        Dry run. Don't execute commands."
     echo "-v        Verbose. Print extra information if appropriate."
     echo "Remove a submodule from .gitmodules, .git/modules, and projects/.") 1>&2
}

FFLAG=
DRY_RUN=
VFLAG=
while getopts fhnv OPTCHAR; do
    case $OPTCHAR in
        f)  FFLAG=-f;;
        h)  usage; exit 0;;
        n)  DRY_RUN=1;;
        v)  VFLAG=1;;
    esac
done

shift $(($OPTIND - 1))

case $# in
    0)  usage; exit 1;;
    *)  ;;
esac

if [[ -d "projects" ]]; then
    PROJECTS="projects"
elif [[ -d "../projects" ]]; then
    PROJECTS="../projects"
else
    echo "Must be run in the top-level directory or where we can find projects." 1>&2
    exit 1
fi

ERR=
for D in "$@"; do
    if [[ ! -d "$PROJECTS/$D" ]]; then
        echo "No such project: $PROJECTS/$D" 1>&2
        ERR=1
        continue
    else
        git rm $FFLAG "$PROJECTS/$D" \
            && rm -rf "$PROJECTS/../.git/modules/$D"
    fi
done

exit $ERR
